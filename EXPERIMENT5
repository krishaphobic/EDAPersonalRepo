import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.datasets import load_iris

# Load the Iris dataset from the official [Scikit-learn Datasets](https://scikit-learn.org)
iris_raw = load_iris(as_frame=True)
df = iris_raw.frame

# Rename target column to species names for better readability
df['target_name'] = df['target'].map({0: 'setosa', 1: 'versicolor', 2: 'virginica'})

# Display basic dataset information
print("--- Dataset Shape ---")
print(df.shape)

print("\n--- Summary Statistics ---")
print(df.describe())

# Set seaborn plotting style
sns.set_theme(style="whitegrid")

# 1. Histograms / Distribution Plots
fig, axes = plt.subplots(2, 2, figsize=(10, 8))
sns.histplot(data=df, x='sepal length (cm)', hue='target_name', kde=True, ax=axes[0, 0])
sns.histplot(data=df, x='sepal width (cm)', hue='target_name', kde=True, ax=axes[0, 1])
sns.histplot(data=df, x='petal length (cm)', hue='target_name', kde=True, ax=axes[1, 0])
sns.histplot(data=df, x='petal width (cm)', hue='target_name', kde=True, ax=axes[1, 1])
plt.suptitle("Distribution of Iris Features by Species")
plt.tight_layout()
plt.show()

# 2. Scatter Plot: Sepal Dimensions
plt.figure(figsize=(8, 5))
sns.scatterplot(data=df, x='sepal length (cm)', y='sepal width (cm)', hue='target_name', palette='deep')
plt.title("Sepal Length vs Sepal Width")
plt.show()

# 3. Scatter Plot: Petal Dimensions
plt.figure(figsize=(8, 5))
sns.scatterplot(data=df, x='petal length (cm)', y='petal width (cm)', hue='target_name', palette='deep')
plt.title("Petal Length vs Petal Width")
plt.show()

# 4. Correlation Heatmap
plt.figure(figsize=(6, 5))
numeric_df = df.drop(columns=['target', 'target_name'])
sns.heatmap(numeric_df.corr(), annot=True, cmap='coolwarm', fmt=".2f")
plt.title("Correlation Heatmap of Iris Features")
plt.show()

# 5. Pairplot for Multivariate Analysis
sns.pairplot(df.drop(columns=['target']), hue='target_name', palette='deep')
plt.suptitle("Pairplot of Iris Dataset", y=1.02)
plt.show()
