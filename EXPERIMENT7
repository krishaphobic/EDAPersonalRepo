import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import plotly.express as px
from wordcloud import WordCloud
from scipy.cluster.hierarchy import dendrogram, linkage
from pandas.plotting import parallel_coordinates, andrews_curves

# Create a synthetic dataset
np.random.seed(42)
n_samples = 100

data = {
    'Age': np.random.randint(18, 65, size=n_samples),
    'Income': np.random.normal(55000, 15000, size=n_samples).round(2),
    'Spending_Score': np.random.randint(1, 100, size=n_samples),
    'Education_Level': np.random.choice(['High School', 'Bachelor', 'Master', 'PhD'], size=n_samples, p=[0.3, 0.4, 0.2, 0.1]),
    'Satisfied': np.random.choice(['Yes', 'No'], size=n_samples, p=[0.6, 0.4])
}
df = pd.DataFrame(data)

# --- Pie Chart ---
def plot_pie(data, labels, title="Pie Chart"):
    plt.figure(figsize=(6, 6))
    plt.pie(data, labels=labels, autopct='%1.1f%%', startangle=140, colors=sns.color_palette("pastel"))
    plt.title(title)
    plt.show()

edu_counts = df['Education_Level'].value_counts()
plot_pie(edu_counts.values, edu_counts.index, title="Education Level Proportions")

# --- Bar Chart ---
def plot_bar(categories, values, title="Bar Chart"):
    plt.figure(figsize=(8, 5))
    sns.barplot(x=categories, y=values, palette="muted")
    plt.title(title)
    plt.xlabel("Categories")
    plt.ylabel("Values")
    plt.show()

sat_counts = df['Satisfied'].value_counts()
plot_bar(sat_counts.index, sat_counts.values, title="Customer Satisfaction Counts")

# --- Histogram ---
def plot_histogram(df, column):
    plt.figure(figsize=(8, 5))
    sns.histplot(df[column], kde=True, color="skyblue")
    plt.title(f"Histogram of {column}")
    plt.xlabel(column)
    plt.ylabel("Frequency")
    plt.show()

plot_histogram(df, 'Age')

# --- Scatter Plot ---
plt.figure(figsize=(8, 5))
plt.scatter(df['Age'], df['Income'], color='purple', alpha=0.7, edgecolors='black')
plt.title("Scatter Plot: Age vs Income")
plt.xlabel("Age")
plt.ylabel("Income")
plt.show()

# --- Correlation Heatmap ---
plt.figure(figsize=(8, 5))
sns.heatmap(df.corr(numeric_only=True), annot=True, cmap='coolwarm', fmt=".2f")
plt.title("Correlation Heatmap")
plt.show()

# --- Pair Plot ---
# Automatically builds grids of histograms and scatter plots across the dataframe
sns.pairplot(df, hue='Satisfied', palette='Set1')
plt.suptitle("Pair Plot grouped by Satisfaction", y=1.02)
plt.show()

# --- General Heat Map (Pivot or Aggregated Data Matrix) ---
plt.figure(figsize=(8, 5))
pivot_table = df.pivot_table(values='Spending_Score', index='Education_Level', columns='Satisfied', aggfunc='mean')
sns.heatmap(pivot_table, annot=True, cmap='coolwarm')
plt.title("Heat Map: Avg Spending Score by Education & Satisfaction")
plt.show()

# --- Word Cloud ---
# Generate dummy feedback text based on categorical distributions
text_data = " ".join((df['Education_Level'] + " ") * 3 + (df['Satisfied'] + " "))
wordcloud = WordCloud(width=800, height=400, background_color='white').generate(text_data)

plt.figure(figsize=(10, 5))
plt.imshow(wordcloud, interpolation='bilinear')
plt.axis('off')
plt.title("Word Cloud of Categorical Attributes")
plt.show()

# --- Choropleth Map ---
# Creating dummy geographical data for mapping
geo_data = pd.DataFrame({
    'State_Code': ['CA', 'TX', 'NY', 'FL', 'IL'],
    'Value': [100, 85, 70, 60, 45]
})
fig = px.choropleth(geo_data, locations='State_Code', locationmode="USA-states",
                    color='Value', scope="usa", title="Choropleth Map Example")
fig.show()

# --- Dendrogram ---
# Select only continuous fields for clustering distance matrix evaluation
numeric_df = df[['Age', 'Income', 'Spending_Score']].head(15)  # Sampled first 15 for visualization clarity
linked = linkage(numeric_df, 'single')

plt.figure(figsize=(10, 5))
dendrogram(linked, labels=numeric_df.index.tolist())
plt.title("Dendrogram (Hierarchical Clustering Sample)")
plt.show()

# --- Parallel Coordinate Plot ---
plt.figure(figsize=(10, 5))
parallel_coordinates(df[['Age', 'Income', 'Spending_Score', 'Satisfied']], 'Satisfied', color=('#E74C3C', '#3498DB'))
plt.title("Parallel Coordinate Plot")
plt.show()

# --- Andrews Curves ---
plt.figure(figsize=(10, 5))
andrews_curves(df[['Age', 'Income', 'Spending_Score', 'Satisfied']], 'Satisfied', color=('#E74C3C', '#3498DB'))
plt.title("Andrews Curves Plot")
plt.show()


