import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import plotly.express as px
from wordcloud import WordCloud
from scipy.cluster.hierarchy import dendrogram, linkage
from pandas.plotting import parallel_coordinates, andrews_curves

# 1. Load the dataset (replace string path with your filename if needed)
# df = pd.read_csv('winqt.csv')
# Using the uploaded snippet representation:
df = pd.read_csv("winqt.csv") 

# --- Pie Chart (Quality Proportions) ---
def plot_pie(data, labels, title="Pie Chart"):
    plt.figure(figsize=(6, 6))
    plt.pie(data, labels=labels, autopct='%1.1f%%', startangle=140, colors=sns.color_palette("pastel"))
    plt.title(title)
    plt.show()

quality_counts = df['quality'].value_counts()
plot_pie(quality_counts.values, quality_counts.index.astype(str), title="Wine Quality Rating Proportions")

# --- Bar Chart (Wine Count by Quality) ---
def plot_bar(categories, values, title="Bar Chart"):
    plt.figure(figsize=(8, 5))
    sns.barplot(x=categories, y=values, palette="muted", hue=categories, legend=False)
    plt.title(title)
    plt.xlabel("Quality Grade")
    plt.ylabel("Number of Wines")
    plt.show()

plot_bar(quality_counts.index.astype(str), quality_counts.values, title="Wine Count by Quality Score")

# --- Histogram (Alcohol Content Distribution) ---
def plot_histogram(df, column):
    plt.figure(figsize=(8, 5))
    sns.histplot(df[column], kde=True, color="skyblue")
    plt.title(f"Distribution Baseline: Histogram of {column}")
    plt.xlabel(column)
    plt.ylabel("Frequency")
    plt.show()

plot_histogram(df, 'alcohol')

# --- Scatter Plot (Fixed Acidity vs pH) ---
plt.figure(figsize=(8, 5))
plt.scatter(df['fixed acidity'], df['pH'], color='purple', alpha=0.7, edgecolors='black')
plt.title("Scatter Plot: Fixed Acidity vs pH")
plt.xlabel("Fixed Acidity")
plt.ylabel("pH Balance")
plt.show()

# --- Correlation Heatmap ---
plt.figure(figsize=(10, 8))
# Dropping ID column as it contains arbitrary indices
sns.heatmap(df.drop(columns=['Id'], errors='ignore').corr(), annot=True, cmap='coolwarm', fmt=".2f")
plt.title("Correlation Matrix Matrix of Wine Attributes")
plt.show()

# --- Pair Plot (Grouped by Quality) ---
# Selecting a subset of major components for pair-plot clarity
subset_cols = ['fixed acidity', 'volatile acidity', 'alcohol', 'quality']
sns.pairplot(df[subset_cols], hue='quality', palette='Set1')
plt.suptitle("Pair Plot Matrix Grouped by Wine Quality", y=1.02)
plt.show()

# --- General Heat Map (Avg Alcohol by Quality and Acidity brackets) ---
plt.figure(figsize=(8, 5))
# Create dummy bracket segments for matrix comparison structure
df['Acidity_Type'] = pd.qcut(df['fixed acidity'], q=3, labels=['Low Acid', 'Med Acid', 'High Acid'])
pivot_table = df.pivot_table(values='alcohol', index='Acidity_Type', columns='quality', aggfunc='mean')
sns.heatmap(pivot_table, annot=True, cmap='coolwarm', fmt=".2f")
plt.title("Heat Map: Avg Alcohol Content by Acidity Type & Quality")
plt.show()

# --- Word Cloud (Textual Quality Visualizer) ---
# Simulating a string cloud matching the quality distribution ratios
text_data = " ".join([f"Quality_{q} " * count for q, count in quality_counts.items()])
wordcloud = WordCloud(width=800, height=400, background_color='white').generate(text_data)

plt.figure(figsize=(10, 5))
plt.imshow(wordcloud, interpolation='bilinear')
plt.axis('off')
plt.title("Word Cloud Distribution of Quality Rankings")
plt.show()

# --- Dendrogram (Hierarchical Clustering Matrix) ---
# Sampling the first 15 records for visualization framework accuracy
numeric_df = df[['fixed acidity', 'volatile acidity', 'citric acid', 'residual sugar', 'chlorides', 'pH', 'alcohol']].head(15)
linked = linkage(numeric_df, 'single')

plt.figure(figsize=(10, 5))
dendrogram(linked, labels=numeric_df.index.tolist())
plt.title("Hierarchical Cluster Dendrogram (Sample Sample Matrix)")
plt.show()

# --- Parallel Coordinate Plot ---
plt.figure(figsize=(10, 5))
# Using standard features normalizations for visual legibility
features_to_plot = ['fixed acidity', 'volatile acidity', 'pH', 'alcohol', 'quality']
parallel_coordinates(df[features_to_plot], 'quality', color=sns.color_palette("Set1", len(quality_counts)))
plt.title("Parallel Coordinate Plot Layout")
plt.show()

# --- Andrews Curves Plot ---
plt.figure(figsize=(10, 5))
andrews_curves(df[features_to_plot], 'quality', color=sns.color_palette("Set1", len(quality_counts)))
plt.title("Andrews Curves Geometries Plot")
plt.show()
