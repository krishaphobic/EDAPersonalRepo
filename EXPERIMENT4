# Set consistent visualization parameters
sns.set_theme(style="white")
plt.rcParams['figure.figsize'] = (10, 6)

# =====================================================================
# VISUALIZATION 1: Correlation Matrix Heatmap
# =====================================================================
# Uncovers directional dependencies among all chemical measurements.
plt.figure(figsize=(10, 8))
correlation_matrix = df.corr()
sns.heatmap(correlation_matrix, annot=True, cmap='coolwarm', fmt=".2f", linewidths=0.5, vmin=-1, vmax=1)
plt.title("Correlation Matrix of Wine Physicochemical Features", fontsize=14, weight='bold', pad=15)
plt.tight_layout()
plt.show()

# =====================================================================
# VISUALIZATION 2: Key Quality Drivers Matrix (Clustered Scatter Mappings)
# =====================================================================
# Targets the components most correlated with Quality: Alcohol & Volatile Acidity.
g = sns.FacetGrid(df, hue="quality", palette="deep", height=5, aspect=1.4)
g.map(sns.scatterplot, "alcohol", "volatile acidity", alpha=0.8, edgecolor="w", s=70)
g.add_legend(title="Wine Quality Rating")
plt.title("Multivariate Space: Alcohol vs Volatile Acidity Stratified by Quality", fontsize=12, weight='bold', pad=15)
plt.xlabel("Alcohol Content (%)")
plt.ylabel("Volatile Acidity (g/dm³)")
plt.grid(True, alpha=0.3)
plt.show()

# =====================================================================
# VISUALIZATION 3: Distribution Matrix of Acids across Quality Scores
# =====================================================================
