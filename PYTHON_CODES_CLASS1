import random

def play_numberle():
    secret_number = "".join([str(random.randint(0, 9)) for _ in range(5)])
    
    max_attempts = 6
    print("🔢 Welcome to Numberle (Digit Wordle)!")
    print("Guess the secret 5-digit number. You have 6 attempts.")
    print("Clues: G = Correct spot 🟩 | Y = Wrong spot 🟨 | X = Not in number ⬛\n")

    for attempt in range(1, max_attempts + 1):
        while True:
            guess = input(f"Attempt {attempt}/{max_attempts} | Enter 5 digits: ").strip()
            if len(guess) == 5 and guess.isdigit():
                break
            print("⚠️ Invalid input. Please enter exactly 5 numbers (0-9).")

        if guess == secret_number:
            print(f"🎉 Congratulations! You guessed the number {secret_number} in {attempt} attempts!")
            return

        clues = ["X"] * 5
        secret_remaining = list(secret_number)
        guess_remaining = list(guess)

        for i in range(5):
            if guess[i] == secret_number[i]:
                clues[i] = "G"
                secret_remaining[i] = None  # Consume the digit
                guess_remaining[i] = None

        for i in range(5):
            if guess_remaining[i] is not None:
                digit = guess_remaining[i]
                if digit in secret_remaining:
                    clues[i] = "Y"
                    secret_remaining[secret_remaining.index(digit)] = None  # Consume one matching digit

        print(f"Feedback : {' '.join(clues)}")
        print("-" * 35)

    print(f"💀 Game Over! The secret number was {secret_number}.")

if __name__ == "__main__":
    play_numberle()

