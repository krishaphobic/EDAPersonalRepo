class Patient:
    def __init__(self, name, age):
        self.name = name          # Attribute
        self.age = age            # Attribute
        self.vitals = []          # Attribute starting as empty list

    def add_heart_rate(self, bpm):
        self.vitals.append(bpm)

    def get_status(self):
        return f"Patient {self.name} ({self.age}yo) | Latest BPM: {self.vitals[-1] if self.vitals else 'No data'}"

patient_1 = Patient("Alice Smith", 34)
patient_1.add_heart_rate(72)

print(patient_1.get_status())

